byte reverseBits(byte b) {
  byte r = 0;
  for (int i = 0; i < 8; i++) if (b & (1 << i)) r |= 1 << (7 - i);
  return r;
}

// One column of the message (each letter = 5 columns + 1 blank)
byte messageColumn(int index) {
  int charIndex = index / 6;
  int col = index % 6;
  char c = MESSAGE[charIndex];
  if (c >= 'a' && c <= 'z') c -= 32;          // lowercase -> uppercase
  if (c < 32 || c > 90 || col == 5) return 0;
  return pgm_read_byte(&FONT[c - 32][col]);
}

void drawColumn(int x, byte bits) {           // x = 0 (left) .. 31 (right)
  int dev = x / 8;
  int col = x % 8;
  if (REVERSE_DEVICES) dev = DEVICES - 1 - dev;
  if (FLIP) col = 7 - col;
  if (ROTATE) lc.setRow(dev, col, bits);
  else lc.setColumn(dev, col, reverseBits(bits));
}

void setup() {
  for (int d = 0; d < DEVICES; d++) {
    lc.shutdown(d, false);
    lc.setIntensity(d, INTENSITY);
    lc.clearDisplay(d);
  }
}

void loop() {
  int totalColumns = strlen(MESSAGE) * 6;
  for (int offset = 0; offset < totalColumns; offset++) {
    for (int x = 0; x < DEVICES * 8; x++) {
      drawColumn(x, messageColumn((offset + x) % totalColumns));
    }
    delay(SPEED_MS);
  }
}
