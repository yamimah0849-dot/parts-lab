/*
  Scrolling Name Sign — Parts Lab
  Boards: Arduino Uno / Nano / Mega / Leonardo
  Library: LedControl
  Wiring: MAX7219 4-in-1 (32x8): VCC -> 5V, GND -> GND, DIN -> 12, CS -> 10, CLK -> 11
*/
#include <LedControl.h>
#include <avr/pgmspace.h>

const char MESSAGE[] = "  HELLO LAB MEMBER 001!  ";   // CHANGE ME (A-Z, 0-9, ! ? . , - : ' ")
const int DEVICES = 4;
const int INTENSITY = 2;        // 0..15 (keep low on USB power)
const int SPEED_MS = 45;        // lower = faster scrolling
// 4-in-1 modules differ. If text is mirrored, upside down or jumbled, flip these one at a time:
const bool REVERSE_DEVICES = true;
const bool ROTATE = false;
const bool FLIP = false;

LedControl lc(12, 11, 10, DEVICES);   // DIN, CLK, CS

// Classic 5x7 font for ASCII 32 (space) .. 90 (Z). Each byte is one column, bit 0 = top.
const byte FONT[][5] PROGMEM = {
  {0x00,0x00,0x00,0x00,0x00},{0x00,0x00,0x5F,0x00,0x00},{0x00,0x07,0x00,0x07,0x00},{0x14,0x7F,0x14,0x7F,0x14},
